{
  "name": "sympora-symposium-portal",
  "version": "1.0.0",
  "description": "Symposium Management & Workshop Registration System - Created by Jaishree K",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:client",
    "seed": "node server/utils/seedData.js",
    "install:all": "npm install && npm --prefix client install",
    "zip": "tar -a -c -f symposium-portal-jaishree-k.zip --exclude=\"node_modules\" --exclude=\".git\" --exclude=\"data\" --exclude=\"symposium-portal-jaishree-k.zip\" *"
  },
  "keywords": [
    "mern",
    "symposium-management",
    "workshop-registration",
    "college-portal",
    "event-rsvp"
  ],
  "author": "Jaishree K",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
